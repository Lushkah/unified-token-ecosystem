# Platform Configuration
PLATFORM_ENV=development
PLATFORM_HOST=0.0.0.0
PLATFORM_PORT=8000
PLATFORM_DEBUG=true
LOG_LEVEL=INFO

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/token_ecosystem
DATABASE_ECHO=true

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# OpenAI Configuration (for AI agents)
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4

# Blockchain Configuration
# Ethereum Network RPC
ETH_RPC_URL=http://localhost:8545
ETH_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key
ETH_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
ETH_POLYGON_RPC_URL=https://polygon-rpc.com

# Smart Contract Deployment
PRIVATE_KEY=your-wallet-private-key
PAYER_ADDRESS=your-wallet-address

# Token Contract Configuration
TOKEN_NAME=Unified Token
TOKEN_SYMBOL=UTE
TOKEN_DECIMALS=18
TOKEN_INITIAL_SUPPLY=1000000000

# Contract Addresses (After deployment)
TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
REWARDS_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
GOVERNANCE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Security Configuration
ENCRYPTION_KEY=your-32-char-encryption-key-here
AI_SECURITY_ENABLED=true
ANOMALY_DETECTION_THRESHOLD=0.8

# Agent Configuration
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=300
AGENT_PARALLEL_TASKS=5

# Task Configuration
TASK_QUEUE_SIZE=1000
TASK_TIMEOUT_SECONDS=600
TASK_RETRY_DELAY_SECONDS=30

# Reward Configuration
BASE_REWARD_PER_TASK=10
QUALITY_BONUS_MULTIPLIER=1.5
INNOVATION_BONUS=50
EFFICIENCY_BONUS_MULTIPLIER=1.2

# Governance Configuration
VOTING_PERIOD_BLOCKS=45818
VOTING_QUORUM_PERCENTAGE=4
PROPOSAL_THRESHOLD=65000

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@tokenecosystem.io

# Monitoring & Analytics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# Development Tools
DEBUG_MODE=false
PROFILE_ENABLED=false
