{
  "openapi": "3.1.1",
  "info": {
    "title": "DEX Screener API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.dexscreener.com"
    }
  ],
  "paths": {
    "/token-profiles/latest/v1": {
      "get": {
        "tags": [
          "Token Profiles"
        ],
        "summary": "Get the latest token profiles (rate-limit 60 requests per minute)",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenProfile"
                }
              }
            }
          }
        }
      }
    },
    "/token-profiles/recent-updates/v1": {
      "get": {
        "tags": [
          "Token Profiles"
        ],
        "summary": "Get recently updated token profiles (rate-limit 60 requests per minute)",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenProfile"
                }
              }
            }
          }
        }
      }
    },
    "/community-takeovers/latest/v1": {
      "get": {
        "tags": [
          "Community Takeovers"
        ],
        "summary": "Get the latest token community takeovers (rate-limit 60 requests per minute)",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunityTakeoverResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ads/latest/v1": {
      "get": {
        "tags": [
          "Ads"
        ],
        "summary": "Get the latest ads (rate-limit 60 requests per minute)",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/token-boosts/latest/v1": {
      "get": {
        "tags": [
          "Token Boosts"
        ],
        "summary": "Get the latest boosted tokens (rate-limit 60 requests per minute)",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoostsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/token-boosts/top/v1": {
      "get": {
        "tags": [
          "Token Boosts"
        ],
        "summary": "Get the tokens with most active boosts (rate-limit 60 requests per minute)",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoostsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orders/v1/{chainId}/{tokenAddress}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Check orders paid for of token (rate-limit 60 requests per minute)",
        "parameters": [
          {
            "name": "chainId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "examples": {
              "default": {
                "value": "solana"
              }
            }
          },
          {
            "name": "tokenAddress",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "examples": {
              "default": {
                "value": "A55XjvzRU4KtR3Lrys8PpLZQvPojPqvnv5bJVHMYy3Jv"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/latest/dex/pairs/{chainId}/{pairId}": {
      "get": {
        "tags": [
          "Pairs"
        ],
        "summary": "Get one or multiple pairs by chain and pair address (rate-limit 300 requests per minute)",
        "parameters": [
          {
            "name": "chainId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "examples": {
              "default": {
                "value": "solana"
              }
            }
          },
          {
            "name": "pairId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "examples": {
              "default": {
                "value": "JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/tokens/v1/{chainId}/{tokenAddresses}": {
      "get": {
        "tags": [
          "Tokens"
        ],
        "summary": "Get one or multiple pairs by token address (rate-limit 300 requests per minute)",
        "parameters": [
          {
            "name": "chainId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "examples": {
              "default": {
                "value": "solana"
              }
            }
          },
          {
            "name": "tokenAddresses",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "One or multiple, comma-separated token addresses (up to 30 addresses)",
              "examples": [
                "So11111111111111111111111111111111111111112,EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokensResponse"
                }
              }
            }
          }
        }
      }
    },
    "/token-pairs/v1/{chainId}/{tokenAddress}": {
      "get": {
        "tags": [
          "Tokens Pairs"
        ],
        "summary": "Get the pools of a given token address (rate-limit 300 requests per minute)",
        "parameters": [
          {
            "name": "chainId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "examples": [
                "solana"
              ]
            }
          },
          {
            "name": "tokenAddress",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "A token addresses",
              "examples": [
                "JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokensPairsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/latest/dex/search": {
      "get": {
        "summary": "Search for pairs matching query (rate-limit 300 requests per minute)",
        "tags": [
          "Search"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "examples": {
              "default": {
                "value": "SOL/USDC"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/metas/trending/v1": {
      "get": {
        "tags": [
          "Metas"
        ],
        "summary": "Get trending metas (rate-limit 60 requests per minute)",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetasTrendingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/metas/meta/v1/{slug}": {
      "get": {
        "tags": [
          "Metas"
        ],
        "summary": "Get meta information for a given slug (rate-limit 60 requests per minute)",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "examples": [
                "ai"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaWithPairsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
